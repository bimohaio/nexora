{
  "name": "web-scada",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "pnpm --filter @web-scada/designer-demo dev",
    "dev:runtime": "pnpm --filter @web-scada/runtime-demo dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --recursive --filter './packages/**' --if-present build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.benchmark.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.benchmark.test.ts'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "vitest run packages/runtime-engine/src/performance.benchmark.test.ts packages/interaction-engine/src/benchmarks/interaction-performance.benchmark.test.ts packages/binding-engine/src/coordinator.benchmark.test.ts tests/performance/phase-9-manager-scaling.benchmark.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "18",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.5.0",
    "globals": "^15.14.0",
    "happy-dom": "15.11.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
